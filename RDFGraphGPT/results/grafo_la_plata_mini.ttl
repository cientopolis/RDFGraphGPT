io:listing_pueblos_del_plata a pronto:RealEstateListing ;
    rdfs:label "Complejo Pueblos del Plata en Hudson, Berazategui" ;
    io:hasFeature io:location_feature_pueblos_del_plata,
                  io:area_feature_pueblos_del_plata,
                  io:security_feature_pueblos_del_plata,
                  io:accessibility_feature_pueblos_del_plata,
                  io:service_feature_pueblos_del_plata,
                  io:lot_sizes_feature_pueblos_del_plata,
                  io:sport_facilities_feature_pueblos_del_plata,
                  io:underground_services_feature_pueblos_del_plata,
                  io:artificial_lakes_feature_pueblos_del_plata,
                  io:forestation_plan_feature_pueblos_del_plata .

io:location_feature_pueblos_del_plata a io:Feature ;
    io:hasDetail [ a io:PostalAddress ;
        io:address "Autopista Bs. As. - La Plata" ;
        io:neighborhood io:neighborhood_Hudson_Berazategui ;
        io:city io:city_Berazategui ;
        io:province io:province_Buenos_Aires ] .

io:area_feature_pueblos_del_plata a io:Area ;
    io:hasDetail [ a gr:QuantitativeValue ;
        gr:hasValue "2500000"^^xsd:float ;  # area in square meters
        gr:hasUnitOfMeasurement "M2" ] .

io:security_feature_pueblos_del_plata a io:Feature ;
    rdfs:label "Security features included" .

io:accessibility_feature_pueblos_del_plata a io:Feature ;
    rdfs:label "High accessibility" .

io:service_feature_pueblos_del_plata a io:Feature ;
    rdfs:label "Includes medical center, school, shopping area" .

io:lot_sizes_feature_pueblos_del_plata a io:Feature ;
    rdfs:label "Lots ranging from 600 m2 to 1500 m2" .

io:sport_facilities_feature_pueblos_del_plata a io:Feature ;
    rdfs:label "Sports club over 100,000 m2 including tennis, soccer, rugby fields" .

io:underground_services_feature_pueblos_del_plata a io:Feature ;
    rdfs:label "Underground utilities" .

io:artificial_lakes_feature_pueblos_del_plata a io:Feature ;
    rdfs:label "Artificial lakes for sports and fishing" .

io:forestation_plan_feature_pueblos_del_plata a io:Feature ;
    rdfs:label "Forestation plan included" .
