io:price_A4200034 a io:Price ;
    io:hasDetail [ a io:TemporalFeature ;
        io:hasScraperValue [ a gr:UnitPriceSpecification ;
            gr:hasCurrency "USD"^^xsd:string ;
            gr:hasCurrencyValue "67000.0"^^xsd:float ] ] .

io:address_A4200034 a io:PostalAddress ;
    io:address "Calle 48 al 600, La Plata, Buenos Aires"^^xsd:string ;
    io:city io:city_La_Plata ;
    io:neighborhood io:neighborhood_Centro_La_Plata ;
    io:province io:province_Buenos_Aires .

io:apartment_A4200034 a io:Apartment ;
    io:hasFeature io:dimensions_A4200034, io:room_details_A4200034, io:property_age_A4200034 .

io:dimensions_A4200034 a io:Dimensions ;
    io:hasDetail [ a io:TemporalFeature ;
        io:hasScraperValue [ a pronto:SizeSpecification ;
            io:surface "41"^^xsd:string ;
            io:surface_type "total"^^xsd:string ],
