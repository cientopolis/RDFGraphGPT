            io:surface "41"^^xsd:string ;
            io:surface_type "cubierta"^^xsd:string ] ] .

io:room_details_A4200034 a io:Feature ;
    io:hasDetail [ a io:TemporalFeature ;
        io:hasScraperValue [ a rec:RoomAmnt ;
            rec:amount "1"^^xsd:int ],
        [ a rec:Bathroom ;
            io:amount "1"^^xsd:int ],
        [ a rec:Bedroom ;
            io:amount "1"^^xsd:int ] ] .

io:property_age_A4200034 a io:PropertyAge ;
    io:hasDetail [ a io:TemporalFeature ;
        io:hasScraperValue "30 años"^^xsd:string ] .```turtle
